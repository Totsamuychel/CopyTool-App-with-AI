# Model used for OCR extraction
OLLAMA_MODEL=qwen2.5vl:7b

# System Prompt for the model
OLLAMA_PROMPT="Прочитай весь текст на этом изображении. Выведи только сам текст, без каких-либо объяснений или комментариев."

# Set to True if you need to access Ollama via an Ngrok tunnel
USE_NGROK=False

# If USE_NGROK is True, provide your token here
NGROK_AUTHTOKEN=your_ngrok_token_here

# Hotkey for the capture tool
HOTKEY=ctrl+shift+x
